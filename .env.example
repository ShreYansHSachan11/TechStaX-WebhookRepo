# MongoDB Configuration (Required)
MONGODB_URI=mongodb://localhost:27017/webhook_system
MONGODB_DATABASE=webhook_system

# Flask Configuration (Required)
FLASK_DEBUG=True
FLASK_PORT=5000
FLASK_HOST=0.0.0.0
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-this-in-production

# Redis Configuration (Required for Celery)
REDIS_URI=redis://localhost:6379

# Celery Configuration (Optional - defaults to Redis URI with different databases)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_DELAY=60

# Logging Configuration (Optional - defaults provided)
LOG_LEVEL=INFO
LOG_FILE_PATH=/app/logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
CELERY_LOG_FILE_PATH=/app/logs/celery.log

# Thread Queue Configuration (Optional - defaults provided)
WEBHOOK_QUEUE_WORKERS=4
WEBHOOK_QUEUE_MAX_SIZE=1000

# GitHub Webhook Security (Optional but recommended)
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# Application Configuration (Optional)
# MAX_CONTENT_LENGTH=16777216  # Maximum request size in bytes (16MB default)
# WEBHOOK_TIMEOUT=30           # Webhook processing timeout in seconds